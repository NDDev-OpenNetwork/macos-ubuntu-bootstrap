      "profile": "desktop",
      "gui_modes": [
        "enabled",
        "disabled"
      ],
      "docker_modes": [
        "none"
      ],
      "execution_policy": "source-lsp-only"
    },
    "ubuntu": {
      "releases": [
        "24.04",
        "26.04"
      ],
      "architectures": [
        "amd64",
        "arm64"
      ],
      "profiles": {
        "desktop": {
          "gui_modes": [
            "enabled",
            "disabled"
          ],
          "docker_modes": [
            "none"
          ],
          "execution_policy": "source-lsp-only"
        },
        "server": {
          "gui_modes": [
            "disabled"
          ],
          "docker_modes": [
            "none",
            "rootful",
            "rootless"
          ],
          "default_docker_mode": "rootful",
          "execution_policy": "container-execution-only"
        }
      }
    }
  },
  "harnesses": {
    "policy": "one-owner-per-harness",
    "active": [
      "codex"
    ],
    "codex": {
      "owner_module": "nddev-codex-app",
      "module_path_env": "RLDYOUR_CODEX_MODULE",
      "module_repo": "https://github.com/NDDev-it-com/nddev-codex-app.git",
      "module_commit": "a69d77f1c62b5e02cdd9b886c412a53cee92e24a",
      "default_setup": "safe"
    },
    "delegated": {
      "zcode": {
        "owner_repo": "nddev-harnesses",
        "owner_module": "modules/nddev-zcode-app",
        "reason": "The ZCode desktop app creates and owns ~/.zcode on first launch. Its installer fails closed on an unstamped target and requires an explicit --adopt-unmanaged, which no unattended bootstrap may pass on the owner's behalf. Bootstrap therefore declares zcode out of scope and never blocks a device apply on it; nddev-harnesses installs it through its own lifecycle."
      }
    }
  },
