  "remote_execution": {
    "client_profiles": ["desktop"],
    "executor_profile": "server",
    "transport": "openssh-exact-head",
    "entrypoint": "scripts/remote-exec.sh",
    "workspace_transfer": "forbidden",
    "dirty_worktree": "forbidden",
    "remote_head_match": "required",
    "credentials": "owner-managed-ssh-agent"
  },
  "harnesses": {
    "policy": "one-owner-per-harness",
    "active": [
      "codex"
    ],
    "codex": {
      "owner_module": "nddev-codex-app",
      "module_path_env": "RLDYOUR_CODEX_MODULE",
      "module_repo": "https://github.com/NDDev-it-com/nddev-codex-app.git",
      "module_commit": "a69d77f1c62b5e02cdd9b886c412a53cee92e24a",
      "default_setup": "full-auto"
    },
    "detection": {
      "_doc": "one-owner-per-harness (RVR-P1-004) was prose only: nothing on a device could tell whether a catalogued harness resolved to the target its declared owner publishes, or to a second copy from a package-manager global. Each entry below is a probe device_integrity records into the receipt. `owned-prefix` fails closed when the command resolves outside the owner's target; `observe-only` records presence without acting, which is what a delegated on-pause harness requires.",
      "codex": {
        "command": "codex",
        "enforcement": "owned-prefix",
        "owned_prefix_env": "RLDYOUR_CODEX_HOME",
        "owned_prefix_default": "${HOME}/.codex",
        "reason": "nddev-codex-app publishes its standalone CLI only under its own target; a codex resolving anywhere else is a second owner."
      },
      "zcode": {
        "command": "zcode",
        "enforcement": "observe-only",
        "reason": "Delegated and on-pause. Bootstrap never installs, starts, verifies, removes, or adopts it, so presence is recorded as drift evidence and never acted on."
      }
    },
    "delegated": {
      "zcode": {
        "work_policy": "on-pause",
        "owner_repo": "nddev-harnesses",
        "owner_module": "modules/nddev-zcode-app",
        "reason": "ZCode remains catalogued but its global work-policy is on-pause. Bootstrap never installs, starts, verifies, removes, or adopts it; any installed copy is preserved until a separate approved device plan changes that state."
      }
    }
  },
